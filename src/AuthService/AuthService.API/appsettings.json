{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // 12-Factor III — Config: Gizli değerler ortam değişkeninden gelir.
  // Bu dosyada sadece şablon değerler veya dev defaults bulunur.
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "AuthService",
    "Audience": "MicroserviceSolution",
    "ExpiryInMinutes": "15"
  },

  "ConnectionStrings": {
    // Docker compose'da AUTH_DB_CONNECTION env var ile override edilir.
    "DefaultConnection": "${AUTH_DB_CONNECTION}"
  }
}
