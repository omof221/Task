# 12-Factor Config: Ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin
# .env dosyası asla git'e commit edilmez!

# PostgreSQL
POSTGRES_USER=msuser
POSTGRES_PASSWORD=mspassword
POSTGRES_DB=microservices

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=SuperSecretKeyForJwtTokenGeneration2024!ChangeInProduction
JWT_ISSUER=MicroserviceAuth
JWT_AUDIENCE=MicroserviceClients
JWT_EXPIRY_MINUTES=60

# Elasticsearch (optional)
ELASTICSEARCH_URI=http://elasticsearch:9200
